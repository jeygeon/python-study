   "source": [
    "#### Lamda : 람다함수\n",
    "람다함수란 이름없이 간단하게 작성 할 수 있는 함수이다.\n",
    "\n",
    "일반함수는 `def`를 사용하지만 람다함수는 `lamda` 키워드를 사용한다.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "613ed74f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3\n"
     ]
    }
   ],
   "source": [
    "# 일반함수\n",
    "def add(a, b):\n",
    "    print(a + b)\n",
    "\n",
    "add(1, 2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "36df3b41",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "3"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# 람다함수\n",
    "add = lambda a, b : a + b\n",
    "\n",
    "add(1, 2)"
   ]
  }
 ],
